{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-fullmeta-schema": "../../../schema-editor/schema-editor.schema.json",
  "$id": "https://fullmeta.local/ui/fullmeta-ui-plot3d-1.schema.json",
  "title": "FullMeta UI Plot 3D Data 1",
  "description": "Application-neutral scalar values on 3D polygon surfaces. The host may provide projection and view interaction to share a camera with other graphics.",
  "type": "object",
  "required": ["surfaces"],
  "properties": {
    "background": { "type": "string", "description": "Optional CSS color used to clear the plot canvas." },
    "surfaces": { "type": "array", "items": { "$ref": "#/$defs/surface" } },
    "range": { "$ref": "#/$defs/range" },
    "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "position": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "vertex": {
      "type": "object",
      "required": ["position", "value"],
      "properties": {
        "position": { "$ref": "#/$defs/position" },
        "value": { "type": "number" }
      },
      "additionalProperties": false
    },
    "face": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 3,
      "description": "Vertex indexes describing a polygon face; the renderer triangulates faces with more than three vertices."
    },
    "surface": {
      "type": "object",
      "required": ["vertices", "faces"],
      "properties": {
        "vertices": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/vertex" } },
        "faces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/face" } }
      },
      "additionalProperties": false
    },
    "range": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2,
      "items": false,
      "description": "Optional minimum and maximum for the scalar color range."
    }
  }
}
