{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-fullmeta-schema": "../../../schema-editor/schema-editor.schema.json",
  "$id": "https://fullmeta.local/ui/fullmeta-ui-relatedFields-1.schema.json",
  "title": "FullMeta related fields UI 1",
  "type": "object",
  "properties": {
    "x-fullmeta-ui-relatedFields": { "$ref": "#/$defs/relatedFields" }
  },
  "$defs": {
    "relatedFields": {
      "type": "object",
      "required": ["siblings"],
      "properties": {
        "siblings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "label": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
