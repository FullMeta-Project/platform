{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-fullmeta-schema": "../../../schema-editor/schema-editor.schema.json",
  "$id": "https://fullmeta.local/ui/fullmeta-ui-repeatableChoiceTable-1.schema.json",
  "title": "FullMeta Repeatable Choice Table UI 1",
  "description": "Application-neutral contract for a variable-row table whose rows select unique values from a declared choice source.",
  "type": "object",
  "properties": {
    "x-fullmeta-ui-repeatableChoiceTable": {
      "$ref": "#/$defs/repeatableChoiceTable"
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "choiceSource": {
      "type": "object",
      "required": ["scope", "path"],
      "properties": {
        "scope": { "enum": ["root", "document", "component", "engine", "runtime"] },
        "path": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "valueProperty": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/text" }
    },
    "repeatableChoiceTable": {
      "type": "object",
      "required": ["choiceSource"],
      "properties": {
        "choiceSource": { "$ref": "#/$defs/choiceSource" },
        "choiceValueProperty": { "$ref": "#/$defs/text" },
        "choiceAssignments": { "$ref": "#/$defs/stringMap" },
        "uniqueBy": { "$ref": "#/$defs/text" },
        "generatedIdProperty": { "$ref": "#/$defs/text" },
        "generatedIdTemplate": { "$ref": "#/$defs/text" },
        "generatedIdPrefix": { "$ref": "#/$defs/text" },
        "rowDefaults": { "type": "object" },
        "siblingMirrors": { "$ref": "#/$defs/stringMap" },
        "choiceLabelTemplate": { "$ref": "#/$defs/text" },
        "choiceDescriptionTemplate": { "$ref": "#/$defs/text" },
        "rowLabelTemplate": { "$ref": "#/$defs/text" },
        "labels": { "$ref": "#/$defs/stringMap" },
        "addLabel": { "$ref": "#/$defs/text" },
        "removeLabel": { "$ref": "#/$defs/text" },
        "removeAriaLabelTemplate": { "$ref": "#/$defs/text" },
        "ariaLabel": { "$ref": "#/$defs/text" },
        "helpText": { "$ref": "#/$defs/text" },
        "emptyMessage": { "$ref": "#/$defs/text" },
        "noChoicesMessage": { "$ref": "#/$defs/text" },
        "noUniqueChoiceMessage": { "$ref": "#/$defs/text" },
        "noAvailableChoicesMessage": { "$ref": "#/$defs/text" },
        "invalidChoiceMessage": { "$ref": "#/$defs/text" },
        "duplicateChoiceMessage": { "$ref": "#/$defs/text" },
        "changeMessage": { "$ref": "#/$defs/text" },
        "removeMessage": { "$ref": "#/$defs/text" },
        "minimumRowsMessage": { "$ref": "#/$defs/text" },
        "maximumRowsMessage": { "$ref": "#/$defs/text" },
        "addMessage": { "$ref": "#/$defs/text" },
        "addMessageTemplate": { "$ref": "#/$defs/text" },
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
