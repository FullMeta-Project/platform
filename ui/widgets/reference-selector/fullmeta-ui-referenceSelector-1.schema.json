{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-fullmeta-schema": "../../../schema-editor/schema-editor.schema.json",
  "$id": "https://fullmeta.local/ui/fullmeta-ui-referenceSelector-1.schema.json",
  "title": "FullMeta Reference Selector UI 1",
  "description": "Application-neutral presentation options for a selector whose eligible values are supplied by the host.",
  "type": "object",
  "properties": {
    "x-fullmeta-ui-referenceSelector": {
      "$ref": "#/$defs/referenceSelector"
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "optionList": {
      "type": "array",
      "items": { "$ref": "#/$defs/option" }
    },
    "referenceSelector": {
      "type": "object",
      "properties": {
        "maxVisibleOptions": { "type": "integer", "minimum": 2, "maximum": 20 },
        "emptyMessage": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
