{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-fullmeta-schema": "../../../schema-editor/schema-editor.schema.json",
  "$id": "https://fullmeta.local/ui/fullmeta-ui-valueControl-1.schema.json",
  "title": "FullMeta Value Control UI 1",
  "description": "Optional application-neutral presentation for a JSON Schema primitive or enumeration. The schema still owns the type and allowed values.",
  "type": "object",
  "properties": {
    "x-fullmeta-ui-valueControl": { "$ref": "#/$defs/valueControl" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "choiceSource": {
      "type": "object",
      "required": ["scope", "path"],
      "properties": {
        "scope": { "enum": ["root", "document", "model", "component", "engine", "runtime"] },
        "path": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "valueProperty": { "$ref": "#/$defs/text" },
        "labelTemplate": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": true
    },
    "valueControl": {
      "type": "object",
      "properties": {
        "optionalToggleLabel": { "$ref": "#/$defs/text" },
        "hiddenWhenSiblingPropertyEquals": {
          "type": "object",
          "required": ["property", "value"],
          "properties": {
            "property": { "$ref": "#/$defs/text" },
            "value": { "type": ["string", "number", "boolean", "null"] }
          },
          "additionalProperties": false
        },
        "placeholder": { "$ref": "#/$defs/text" },
        "multiline": { "type": "boolean" },
        "choiceLabels": { "type": "object", "additionalProperties": { "$ref": "#/$defs/text" } },
        "choiceSource": { "$ref": "#/$defs/choiceSource" },
        "onChangeAction": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    }
  }
}
