{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullmeta.local/contracts/native-operation-tools.generated.schema.json",
  "x-fullmeta-schema": "../schema-editor/schema-editor.schema.json",
  "title": "Generated native operation tool inputs",
  "$comment": "Source exact-byte SHA256 5d0399b04f30aeaae0e9e71793ead604b4ff119ae7557908279a1a8d87cf917f. Input schemas are descriptors, not executable authorization.",
  "$defs": {
    "opaqueModel": {
      "type": "object",
      "additionalProperties": true
    },
    "meshInput": {
      "type": "object",
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/opaqueModel"
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "meshCompileInput": {
      "type": "object",
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/opaqueModel"
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "outputDirectory": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "meshCheckResult": {
      "type": "object",
      "required": [
        "modelId",
        "componentId",
        "artifactVersion",
        "geometryHash",
        "bytes"
      ],
      "properties": {
        "modelId": {
          "type": "string"
        },
        "componentId": {
          "type": "string"
        },
        "artifactVersion": {
          "const": 14
        },
        "geometryHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "meshCompileResult": {
      "allOf": [
        {
          "$ref": "#/$defs/meshCheckResult"
        }
      ],
      "type": "object",
      "required": [
        "geoPath",
        "mapPath",
        "geoName",
        "mapName"
      ],
      "properties": {
        "geoPath": {
          "type": "string",
          "minLength": 1
        },
        "mapPath": {
          "type": "string",
          "minLength": 1
        },
        "geoName": {
          "type": "string",
          "minLength": 1
        },
        "mapName": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "prepareStudyInput": {
      "type": "object",
      "required": [
        "model",
        "studyId"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/opaqueModel"
        },
        "studyId": {
          "type": "string",
          "minLength": 1
        },
        "csvFilename": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "preparedStudyResult": {
      "anyOf": [
        {
          "$ref": "#/$defs/preparedStudyPlan"
        },
        {
          "$ref": "#/$defs/preparedSolverRequest"
        }
      ]
    },
    "preparedStudyPlan": {
      "type": "object",
      "required": [
        "schema",
        "studyId",
        "profileId",
        "solverSettings",
        "frequenciesHz",
        "frequencyCases"
      ],
      "properties": {
        "schema": {
          "const": "fullmeta-study-plan/1"
        },
        "studyId": {
          "type": "string",
          "minLength": 1
        },
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "solverSettings": {
          "type": "object"
        },
        "frequenciesHz": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "frequencyCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "preparedSolverRequest": {
      "type": "object",
      "required": [
        "request"
      ],
      "properties": {
        "request": {
          "type": "object",
          "required": [
            "schema",
            "solver",
            "studyId"
          ],
          "properties": {
            "schema": {
              "const": "fem-solver-request/1"
            },
            "solver": {
              "type": "string",
              "minLength": 1
            },
            "studyId": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "studyEvent": {
      "type": "object",
      "required": [
        "type",
        "state"
      ],
      "properties": {
        "type": {
          "enum": [
            "start",
            "progress",
            "mesh",
            "complete",
            "error",
            "cancelled"
          ]
        },
        "state": {
          "enum": [
            "running",
            "success",
            "error",
            "cancelled"
          ]
        },
        "message": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "completedPoints": {
          "type": "integer",
          "minimum": 0
        },
        "totalPoints": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "outputFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "complete"
              }
            }
          },
          "then": {
            "required": [
              "runId",
              "outputFiles"
            ],
            "properties": {
              "state": {
                "const": "success"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "error"
              }
            }
          },
          "then": {
            "required": [
              "message"
            ],
            "properties": {
              "state": {
                "const": "error"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "const": "cancelled"
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "message",
        "path",
        "stage"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "operationId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "mesh.check.input": {
      "$ref": "#/$defs/meshInput"
    },
    "mesh.check.result": {
      "$ref": "#/$defs/meshCheckResult"
    },
    "mesh.check.toolInput": {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/meshInput"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "input"
      ],
      "additionalProperties": false
    },
    "mesh.compile.input": {
      "$ref": "#/$defs/meshCompileInput"
    },
    "mesh.compile.result": {
      "$ref": "#/$defs/meshCompileResult"
    },
    "mesh.compile.toolInput": {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/meshCompileInput"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "input"
      ],
      "additionalProperties": false
    },
    "fem.prepareStudy.input": {
      "$ref": "#/$defs/prepareStudyInput"
    },
    "fem.prepareStudy.result": {
      "$ref": "#/$defs/preparedStudyResult"
    },
    "fem.prepareStudy.toolInput": {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/prepareStudyInput"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "input"
      ],
      "additionalProperties": false
    },
    "fem.studyRun.input": {
      "$ref": "#/$defs/opaqueModel"
    },
    "fem.studyRun.event": {
      "$ref": "#/$defs/studyEvent"
    },
    "fem.studyRun.toolInput": {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/opaqueModel"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "input"
      ],
      "additionalProperties": false
    }
  }
}
